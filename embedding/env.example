# Set LAN address for production; bind loopback for local checks.
EMBED_HOST=127.0.0.1
EMBED_PORT=18767
EMBED_TOKEN_FILE=/home/<user>/prt-embed-service/token
EMBED_TLS_CERT=/home/<user>/prt-embed-service/lan.crt
EMBED_TLS_KEY=/home/<user>/prt-embed-service/lan.key
EMBED_MODEL=/home/<user>/prt-e5-benchmark/model_O4.onnx
EMBED_TOKENIZER=/home/<user>/prt-e5-benchmark/tokenizer.json
