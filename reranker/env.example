# Set in the systemd unit (Environment=). Placeholders only.
RERANK_HOST=<station2-lan-ip>
RERANK_PORT=18766
RERANK_TOKEN_FILE=/home/<user>/prt-reranker-service/token   # >=32 chars, chmod 600
RERANK_TLS_CERT=/home/<user>/prt-reranker-service/lan.crt
RERANK_TLS_KEY=/home/<user>/prt-reranker-service/lan.key
HF_HOME=/home/<user>/prt-reranker-bench/hf
HF_HUB_OFFLINE=1
